---
// The boids on their own, with every knob exposed and GPU time per pass.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Boids sandbox</title>
	</head>
	<body>
		<canvas id="boids"></canvas>
		<pre id="stats"></pre>
		<aside id="panel">
			<div id="sliders"></div>
			<div class="row" title="Colour pairs from the old site."><label>palette</label><select id="palette"></select></div>
			<div class="row" title="Colour of boids near the camera. Toward far it sweeps through the hues in between."><label>near</label><input type="color" data-color="nearColor" /></div>
			<div class="row" title="Colour of boids far from the camera."><label>far</label><input type="color" data-color="farColor" /></div>
			<div class="row" title="What everything sits on; the old site’s navy by default."><label>background</label><input type="color" data-color="background" /></div>
			<div class="buttons">
				<button id="gather" title="Draw the flock into the loader ring.">gather</button>
				<button id="release" title="Let the ring burst into the flock.">release</button>
			</div>
			<div class="buttons">
				<button id="copy">copy</button>
				<button id="reset">reset</button>
				<button id="hide">hide</button>
			</div>
		</aside>
		<p id="error" hidden></p>

		<script>
			import { startBoids, type Stats } from '../boids/app';
			import { defaults, palettes, sliders, type Params } from '../boids/params';

			const STORE = 'boids-sandbox-3';
			const load = (): Params => {
				try {
					// Only settings that still exist: removed ones would ride along in every copy.
				const saved = Object.entries(JSON.parse(localStorage.getItem(STORE) ?? '{}'));
				return { ...defaults, ...Object.fromEntries(saved.filter(([key]) => key in defaults)) };
				} catch {
					return { ...defaults };
				}
			};
			// The canvas is see-through: the background is the page's.
			const paintBackground = () => (document.body.style.background = params.background);
			const save = () => {
				paintBackground();
				try {
					localStorage.setItem(STORE, JSON.stringify(params));
				} catch {}
			};
			const params = load();
			document.body.style.background = params.background;
			// For tuning from the console.
			Object.assign(window, { params });
			const $ = <T extends Element>(s: string) => document.querySelector(s) as T;

			const inputs: Array<() => void> = [];


			$<HTMLDivElement>('#sliders').replaceChildren(
				...sliders.map(({ group, items }) => {
					const section = document.createElement('section');
					section.innerHTML = `<h2>${group}</h2>`;
					for (const s of items) {
						const row = document.createElement('div');
						row.className = 'row';
						row.title = s.hint;
						row.innerHTML = `<label>${s.key}</label><input type="range" min="${s.min}" max="${s.max}" step="${s.step}"><input class="value" inputmode="decimal" spellcheck="false">`;
						const [input, value] = row.querySelectorAll('input');
						const sync = () => {
							input.value = String(params[s.key]);
							value.value = String(params[s.key]);
						};
						const set = (n: number) => {
							params[s.key] = n;
							sync();
							save();
						};
						// Rebuilding the flock restarts it, so those wait until the slider is let go.
						input.addEventListener(s.rebuild ? 'change' : 'input', () => set(Number(input.value)));
						if (s.rebuild) input.addEventListener('input', () => (value.value = input.value));
						// The number can be typed, past the slider's range either way.
						value.addEventListener('change', () => {
							const n = Number(value.value);
							if (value.value.trim() !== '' && Number.isFinite(n)) set(n);
							else sync();
						});
						value.addEventListener('keydown', (e) => e.key === 'Enter' && value.blur());
						inputs.push(sync);
						sync();
						section.append(row);
					}
					return section;
				})
			);

			document.querySelectorAll<HTMLInputElement>('[data-color]').forEach((input) => {
				const key = input.dataset.color as 'nearColor' | 'farColor' | 'background';
				input.value = params[key];
				input.addEventListener('input', () => {
					params[key] = input.value;
					save();
					syncPalette();
				});
				inputs.push(() => (input.value = params[key]));
			});

			const palette = $<HTMLSelectElement>('#palette');
			palette.replaceChildren(
				new Option('—', ''),
				...Object.keys(palettes).map((name) => new Option(name, name))
			);
			const syncPalette = () => {
				const match = Object.entries(palettes).find(([, [n, f]]) => n === params.nearColor && f === params.farColor);
				palette.value = match?.[0] ?? '';
			};
			palette.addEventListener('change', () => {
				if (!palette.value) return;
				[params.nearColor, params.farColor] = palettes[palette.value];
				save();
				inputs.forEach((sync) => sync());
			});
			inputs.push(syncPalette);
			syncPalette();

			$<HTMLButtonElement>('#copy').onclick = () => navigator.clipboard.writeText(JSON.stringify(params, null, '\t'));
			$<HTMLButtonElement>('#reset').onclick = () => {
				Object.assign(params, defaults);
				save();
				inputs.forEach((sync) => sync());
			};
			$<HTMLButtonElement>('#hide').onclick = () => document.body.classList.toggle('bare');
			window.addEventListener('keydown', (e) => {
				if (e.key === 'h' && !(e.target instanceof HTMLInputElement)) document.body.classList.toggle('bare');
			});

			const stats = $<HTMLPreElement>('#stats');
			const onStats = (s: Stats) => {
				const lines = [
					`${s.fps.toFixed(0)} fps`,
					`${s.count.toLocaleString()} boids`,
					`${s.dims.join('×')} cells`
				];
				if (s.gpu) {
					const total = Object.values(s.gpu).reduce((a, b) => a + b, 0);
					lines.push('', ...Object.entries(s.gpu).map(([k, v]) => `${k.padEnd(6)} ${v.toFixed(2)} ms`));
					lines.push(`${'gpu'.padEnd(6)} ${total.toFixed(2)} ms`);
				} else {
					lines.push('', 'no timestamp-query: GPU times unavailable');
				}
				stats.textContent = lines.join('\n');
			};
			startBoids($<HTMLCanvasElement>('#boids'), params, { onStats })
				.then((flock) => {
					$<HTMLButtonElement>('#gather').onclick = () => flock.gather();
					$<HTMLButtonElement>('#release').onclick = () => flock.release();
				})
				.catch((e: Error) => {
				const error = $<HTMLParagraphElement>('#error');
				error.textContent = e.message;
				error.hidden = false;
			});
		</script>

		<style is:global>
			:root {
				color-scheme: dark;
				--fg: #fff;
				--dim: #ffffff80;
				--line: #ffffff26;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				height: 100%;
				background: #000;
				color: var(--fg);
				font: 11px/1.4 ui-monospace, 'SF Mono', Menlo, monospace;
				overflow: hidden;
			}
			canvas {
				position: fixed;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				touch-action: none;
			}
			#stats {
				position: fixed;
				top: 16px;
				left: 16px;
				margin: 0;
				pointer-events: none;
				color: var(--dim);
			}
			#panel {
				position: fixed;
				top: 16px;
				right: 16px;
				bottom: 16px;
				width: 300px;
				overflow-y: auto;
				padding: 12px;
				border: 1px solid var(--line);
				background: #000000b3;
				backdrop-filter: blur(12px);
			}
			.bare #panel,
			.bare #stats {
				display: none;
			}
			h2 {
				margin: 14px 0 6px;
				font-size: inherit;
				font-weight: normal;
				color: var(--dim);
				text-transform: uppercase;
				letter-spacing: 0.1em;
			}
			.row {
				display: grid;
				grid-template-columns: 90px 1fr 56px;
				align-items: center;
				gap: 8px;
				min-height: 22px;
			}
			.row .value {
				width: 100%;
				padding: 0;
				font: inherit;
				text-align: right;
				color: var(--dim);
				font-variant-numeric: tabular-nums;
				background: none;
				border: none;
				border-bottom: 1px solid transparent;
				outline: none;
			}
			.row .value:hover,
			.row .value:focus {
				color: var(--fg);
				border-bottom-color: var(--line);
			}
			input[type='range'] {
				width: 100%;
				accent-color: var(--fg);
			}
			select {
				grid-column: span 2;
				padding: 3px 4px;
				font: inherit;
				color: var(--fg);
				background: #000;
				border: 1px solid var(--line);
			}
			input[type='color'] {
				width: 100%;
				height: 20px;
				padding: 0;
				border: 1px solid var(--line);
				background: none;
			}
			.buttons {
				display: flex;
				gap: 4px;
				grid-column: span 2;
			}
			.buttons {
				margin-top: 14px;
			}
			button {
				flex: 1;
				padding: 4px 6px;
				font: inherit;
				color: var(--dim);
				background: none;
				border: 1px solid var(--line);
				cursor: pointer;
			}
			button:hover,
			button.on {
				color: #000;
				background: var(--fg);
			}
			#error[hidden] {
				display: none;
			}
			#error {
				position: fixed;
				inset: 0;
				display: grid;
				place-items: center;
				margin: 0;
				font-size: 14px;
			}
			@media (max-width: 640px) {
				#panel {
					top: auto;
					left: 16px;
					width: auto;
					height: 45%;
				}
			}
		</style>
	</body>
</html>
