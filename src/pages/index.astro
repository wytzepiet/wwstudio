---
import Flock from '../components/Flock.astro';
import { defaults } from '../boids/params';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Wytze Sligting</title>
	</head>
	<body style={`--background: ${defaults.background}`}>
		<Flock />
		<main>
			<h1>
				<span>Making is easy now.</span>
				<span>Knowing what's good isn't.</span>
			</h1>
		</main>

		<style>
			html,
			body {
				margin: 0;
				min-height: 100%;
				background: var(--background);
				color: #fff;
				font-family: system-ui, sans-serif;
			}
			main {
				min-height: 100vh;
				display: grid;
				align-content: end;
				padding: clamp(16px, 5vw, 64px);
				box-sizing: border-box;
			}
			h1 {
				margin: 0;
				font-size: clamp(2.5rem, 7vw, 7rem);
				font-weight: 800;
				line-height: 0.95;
				letter-spacing: -0.04em;
			}
			h1 span {
				display: block;
			}
		</style>
	</body>
</html>
