---
import Flock from '../components/Flock.astro';
import Headline from '../components/Headline.astro';
import { Image } from 'astro:assets';
import { defaults, FLY, PAST, STEP } from '../boids/params';
import sprawl from '../images/work/sprawl.png';
import baantower from '../images/work/baantower.webp'; // render from prsc.nl
import DotGrid from '../components/DotGrid.astro';

// The flight (see <Flock>): the first FLY screens take the camera through the flock to PAST
// beyond it; each screen after that flies on STEP. The intro is said one line a screen, each line
// a stop on the way, arriving at its own size as the camera reaches it.
const D = defaults.distance;
const lines = [
	"Hi, I'm Wytze, a developer in Rotterdam.",
	'I build websites, apps, backends and interactive things like the one you just flew through.',
	'Code got cheap.',
	"What I bring is the part that didn't: an eye for what's good, the judgement to choose, and the ability to express exactly what it should be.",
	'Take a look at some of my work.'
];
// Stop k is reached after FLY + k screens: it sits D beyond where the camera is then.
const stops = lines.map((text, k) => ({ text, depth: -(D + PAST) - k * STEP, scroll: FLY + k }));
// From the last stop the page scrolls as pages do: the work, whose first project already peeks
// in at the bottom of the screen there (PEEK of a screen down).
const PEEK = 0.82;
// The panels stack: each holds still TOP of a screen from the top while the next slides over it.
const TOP = 0.09;
const lastStop = stops.at(-1)!.scroll;
const work = [
	{
		name: 'Sprawl',
		image: sprawl,
		what: 'A multiplayer city-building and traffic game. A Rust simulation server, and a WebGPU client that draws the whole city from code, without a single asset.',
		tags: ['Rust', 'WebGPU', 'Multiplayer', 'In development']
	},
	{
		name: 'Fuse',
		dots: true, // Fuse's own dot grid, from its site
		what: 'An app framework: native apps written in TypeScript and SolidJS, running in QuickJS inside Flutter through Rust, and updated over the air.',
		tags: ['Rust', 'Flutter', 'SolidJS', 'In development']
	},
	{
		name: 'Real-estate sites',
		image: baantower,
		focus: '50% 100%', // the bottom of a tall render: the arches and the street
		what: 'Websites for Dutch real-estate developments, built at PRSC: Baantower, KLOOS, Tree House Rotterdam and more.',
		tags: ['Next.js', 'Sanity', 'Vercel']
	}
];
---

<html lang="en" class="free">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Wytze Sligting</title>
		<script is:inline>
			// The page always opens at the hero, where the loader plays, not where a reload left it.
			history.scrollRestoration = 'manual';
		</script>
	</head>
	<body style={`--background: ${defaults.background}`} data-flight-end={lastStop}>
		<Flock />
		<!-- In the flock's space: the headline floats in front of the flock, the intro's lines wait
		     beyond it, one stop each. -->
		<main data-depth="300">
			<Headline lines={['Making is easy now.', "Knowing what to make isn't."]} />
		</main>
		{
			stops.map((stop, k) => (
				<section class="stop" data-depth={stop.depth} data-at={D} data-fade={k === 0 ? 3 : 1.8} data-recede={stop.scroll === lastStop ? PEEK - TOP : undefined}>
					<p class="text">{stop.text}</p>
				</section>
			))
		}
		<!-- The flight's length, and where scrolling comes to rest: the hero (the lock needs somewhere to
		     rest at the top) and each stop. -->
		<div class="runway" style={`height: ${(lastStop + PEEK) * 100}vh`}>
			{[0, ...stops.map((s) => s.scroll)].map((at) => <div class="rest" style={`top: ${at * 100}vh`} />)}
		</div>

		<section class="work" aria-label="Work">
			<!-- Where scrolling comes to rest: each panel settled in its place (TOP from the top). -->
			{work.map((_, k) => <div class="rest" style={`top: calc(${k} * (82vh + 30vh) - ${TOP * 100}vh)`} />)}
			{
				work.map((item) => (
					<article class="item">
						<div class="image" aria-hidden="true">
							{item.image ? (
								<Image src={item.image} alt="" widths={[800, 1400, 2200]} sizes="(max-width: 72rem) 100vw, 72rem" style={item.focus && `object-position: ${item.focus}`} />
							) : item.dots ? (
								<div class="fuse">
									<DotGrid color="rgba(212, 147, 89, 0.25)" glow={{ x: 0.78, y: 0.25, radius: 0.45, intensity: 0.5 }} />
								</div>
							) : (
								<span>image</span>
							)}
						</div>
						<div class="about">
							<h3>{item.name}</h3>
							<p>{item.what}</p>
							<ul class="tags">
								{item.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</section>

		<script>
			// Each panel, once the next starts sliding over it, shrinks a little and dims behind it.
			const items = [...document.querySelectorAll<HTMLElement>('.item')];
			const stack = () => {
				items.forEach((item, i) => {
					const next = items[i + 1];
					if (!next) return;
					const top = item.getBoundingClientRect().top;
					const covered = Math.min(Math.max((innerHeight - next.getBoundingClientRect().top) / (innerHeight - top), 0), 1);
					item.style.transform = `scale(${1 - 0.06 * covered})`;
					item.style.filter = `brightness(${1 - 0.6 * covered})`;
				});
			};
			addEventListener('scroll', stack, { passive: true });
			addEventListener('resize', stack);
			stack();
		</script>

		<script define:vars={{ FLY }}>
			// The flight through the flock scrolls freely; from the intro's lines on, every gesture comes
			// to rest on the next line or panel.
			const html = document.documentElement;
			const lock = () => html.classList.toggle('free', scrollY / innerHeight < FLY - 0.02);
			addEventListener('scroll', lock, { passive: true });
			lock();
		</script>

		<style>
			/* The old site's scroll lock: every gesture comes to rest on the next stop, never between or
			   past one; no scrollbar. */
			html {
				scroll-snap-type: y mandatory;
				scroll-behavior: smooth;
				scrollbar-width: none;
			}
			html::-webkit-scrollbar {
				display: none;
			}
			html.free {
				scroll-snap-type: none;
			}
			html,
			body {
				margin: 0;
				min-height: 100%;
				background: var(--background);
				color: #fff;
				font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				/* All secondary text: a grey with a little blue in it. */
				--subtle: #8a93a8;
			}
			main {
				display: grid;
				align-content: end;
				padding: clamp(16px, 5vw, 64px);
				box-sizing: border-box;
			}
			/* Only length and resting places: it lies over the planes behind the flock, so it lets the
			   pointer through. */
			.runway {
				position: relative;
				pointer-events: none;
			}
			.rest {
				position: absolute;
				height: 100vh;
				pointer-events: none;
				scroll-snap-align: start;
				scroll-snap-stop: always;
			}
			.stop {
				display: grid;
				place-content: center;
				text-align: center;
				padding: clamp(16px, 5vw, 64px);
				box-sizing: border-box;
			}
			/* The work: an ordinary page, scrolling up over where the flight left off. */
			.work {
				position: relative;
				z-index: 3;
				max-width: 72rem;
				margin: 0 auto;
				padding: 0 clamp(16px, 5vw, 64px) 30vh;
				box-sizing: border-box;
			}
			/* Each project a big panel: its image filling it, the words over its lower edge. */
			.item {
				position: sticky;
				top: 9vh; /* TOP */
				height: 82vh;
				margin-bottom: 30vh;
				transform-origin: 50% 0;
				overflow: hidden;
				border-radius: 28px;
				background: #0a0b1d;
				box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
				isolation: isolate;
			}
			.image {
				position: absolute;
				inset: 0;
				z-index: -1;
				display: grid;
				place-items: center;
				/* Until there are images: a soft glow, so the panel isn't flat. */
				background: radial-gradient(120% 90% at 70% 20%, rgb(80 100 200 / 0.18), transparent 60%);
				transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
			}
			/* :global, as <Image> renders its img outside this page's scoped styles. */
			.image :global(img) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			/* Fuse's site: its near-black, a warm haze where the dots glow. */
			.fuse {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 70% 60% at 78% 25%, rgb(212 147 89 / 0.07), transparent 60%),
					#0d0d0f;
			}
			.image span {
				font-size: 0.875rem;
				color: rgb(255 255 255 / 0.2);
			}
			.item:hover .image {
				transform: scale(1.03);
			}
			.about {
				position: absolute;
				inset: auto 0 0 0;
				padding: clamp(24px, 4vw, 56px);
				padding-top: 12rem;
				background: linear-gradient(to top, rgb(0 0 0 / 0.9), rgb(0 0 0 / 0.6) 55%, transparent);
			}
			.item h3 {
				margin: 0;
				font-size: clamp(2rem, 4.5vw, 3.5rem);
				font-weight: 700;
				line-height: 1;
				letter-spacing: -0.03em;
			}
			.item p {
				max-width: 36rem;
				margin: 1rem 0 0;
				font-size: 1.0625rem;
				line-height: 1.5;
				color: var(--subtle);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}
			.tags li {
				padding: 4px 11px;
				font-size: 0.75rem;
				color: rgb(255 255 255 / 0.75);
				background: rgb(255 255 255 / 0.06);
				border: 1px solid rgb(255 255 255 / 0.12);
				border-radius: 99px;
			}
			.text {
				max-width: 40rem;
				margin: 0;
				text-wrap: balance;
				font-size: clamp(2rem, 4.5vw, 3.5rem);
				font-weight: 700;
				line-height: 1.08;
				letter-spacing: -0.03em;
			}
		</style>
	</body>
</html>
